# AGM - Academic Grade Management
# Variables de entorno para MS-6: Notificaciones

# === Base de datos ===
# Si PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_notificaciones_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Si MongoDB:
# MONGO_URI=mongodb://agm_admin:agm_secret@localhost:27017/agm_notificaciones_db?authSource=admin

# === SMTP (correo electrónico) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=AGM Sistema Academico
SMTP_FROM_EMAIL=noreply@agm.buap.mx

# === Servidor ===
REST_PORT=3006
GRPC_PORT=50056

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

ALUMNOS_GRPC_HOST=ms-alumnos
ALUMNOS_GRPC_PORT=50053

PERIODOS_GRPC_HOST=ms-periodos
PERIODOS_GRPC_PORT=50052

# === CORS ===
CORS_ORIGIN=http://localhost:4200
