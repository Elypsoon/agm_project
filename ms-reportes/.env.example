# AGM - Academic Grade Management
# Variables de entorno para MS-7: Reportes & Estadísticas

# === Base de datos (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_reportes_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# === Servidor ===
REST_PORT=3007
GRPC_PORT=50057

# === Directorio temporal para archivos generados ===
REPORTS_TEMP_DIR=/tmp/reports

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

CALIFICACIONES_GRPC_HOST=ms-calificaciones
CALIFICACIONES_GRPC_PORT=50054

ASISTENCIAS_GRPC_HOST=ms-asistencias
ASISTENCIAS_GRPC_PORT=50055

ALUMNOS_GRPC_HOST=ms-alumnos
ALUMNOS_GRPC_PORT=50053

PERIODOS_GRPC_HOST=ms-periodos
PERIODOS_GRPC_PORT=50052

# === CORS ===
CORS_ORIGIN=http://localhost:4200
