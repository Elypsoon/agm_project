FROM node:20-alpine

WORKDIR /app

ENV NG_CLI_ANALYTICS=false

# Instalar el Angular CLI de manera global para facilitar comandos de desarrollo
RUN npm install -g @angular/cli@20

# Copiar archivos de dependencias primero para aprovechar la caché de Docker
COPY package*.json ./

RUN npm install --legacy-peer-deps

# Copiar el resto del código del proyecto
COPY . .

# Exponer el puerto por defecto de Angular
EXPOSE 4200

# Arrancar el servidor de desarrollo.
# --host 0.0.0.0 permite conexiones externas (fuera del contenedor)
# --poll 2000 es crítico para que funcione el hot-reload en Windows montado sobre WSL2/Hyper-V
CMD ["ng", "serve", "--host", "0.0.0.0", "--poll", "2000"]
