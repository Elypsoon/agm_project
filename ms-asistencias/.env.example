# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-en-produccion
DEBUG=False
ALLOWED_HOSTS=*

# ── Base de datos PostgreSQL ───────────────────────────────────────────────────
DB_NAME=agm_asistencias_db
DB_USER=postgres
DB_PASSWORD=asistencias_dev_2026
DB_HOST=db-asistencias
DB_PORT=5432

# ── Redis (sesiones activas volátiles) ────────────────────────────────────────
REDIS_URL=redis://redis-asistencias:6379/0

# ── Cifrado QR ────────────────────────────────────────────────────────────────
# Genera una clave válida con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QR_SECRET_KEY=COLOCA_AQUI_TU_CLAVE_FERNET_GENERADA
QR_MAX_AGE_SECONDS=60

# ── gRPC propio ───────────────────────────────────────────────────────────────
GRPC_PORT=50055

# ── gRPC MS-Auth (para validar JWT) ───────────────────────────────────────────
MS_AUTH_GRPC_HOST=ms-auth
MS_AUTH_GRPC_PORT=50051

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True

# ── gRPC MS-2 Periodos & Materias ─────────────────────────────────────────────
MS_PERIODOS_GRPC_HOST=ms-periodos
MS_PERIODOS_GRPC_PORT=50052