# AGM - Academic Grade Management
# Variables de entorno para MS-5: Asistencias QR

# === Base de datos (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_asistencias_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# === Redis (sesiones activas) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Servidor ===
REST_PORT=3005
GRPC_PORT=50055

# === QR ===
QR_SECRET_KEY=your_qr_secret_here
QR_EXPIRATION_SECONDS=5

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

ALUMNOS_GRPC_HOST=ms-alumnos
ALUMNOS_GRPC_PORT=50053

PERIODOS_GRPC_HOST=ms-periodos
PERIODOS_GRPC_PORT=50052

# === CORS ===
CORS_ORIGIN=http://localhost:4200
