# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=cambiar en produccion
DEBUG=False
ALLOWED_HOSTS=*

# ── Base de datos PostgreSQL ───────────────────────────────────────────────────
DB_NAME=agm_asistencias_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db-asistencias
DB_PORT=5432

# ── Redis (sesiones activas volátiles) ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cifrado QR ────────────────────────────────────────────────────────────────
# Generar una clave válida con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QR_SECRET_KEY=clave fernet generada
# Tiempo máximo en segundos que un QR es válido (recomendado: 60)
QR_MAX_AGE_SECONDS=60

# ── gRPC propio ───────────────────────────────────────────────────────────────
GRPC_PORT=50055

# ── gRPC MS-Auth (para validar JWT) ───────────────────────────────────────────
MS_AUTH_GRPC_HOST=ms-auth
MS_AUTH_GRPC_PORT=50051

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
# En producción cambiar a False y especificar orígenes:
# CORS_ALLOWED_ORIGINS=https://tu-frontend.com