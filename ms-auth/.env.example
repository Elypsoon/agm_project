# AGM - Academic Grade Management
# Variables de entorno para MS-1: Auth & Users

# === Base de datos (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_auth_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# === JWT ===
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# === Servidor ===
REST_PORT=3001
GRPC_PORT=50051

# === CORS ===
CORS_ORIGIN=http://localhost:4200

# === SMTP (o delegar al MS-6 Notificaciones via gRPC) ===
NOTIFICACIONES_GRPC_HOST=ms-notificaciones
NOTIFICACIONES_GRPC_PORT=50056
