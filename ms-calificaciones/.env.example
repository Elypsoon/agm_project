# AGM - Academic Grade Management
# Variables de entorno para MS-4: Calificaciones & Ponderaciones

# === Base de datos ===
# Si PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_calificaciones_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Si MongoDB:
# MONGO_URI=mongodb://agm_admin:agm_secret@localhost:27017/agm_calificaciones_db?authSource=admin

# === Servidor ===
REST_PORT=3004
GRPC_PORT=50054

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

ALUMNOS_GRPC_HOST=ms-alumnos
ALUMNOS_GRPC_PORT=50053

PERIODOS_GRPC_HOST=ms-periodos
PERIODOS_GRPC_PORT=50052

# === CORS ===
CORS_ORIGIN=http://localhost:4200
