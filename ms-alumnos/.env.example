# AGM - Academic Grade Management
# Variables de entorno para MS-3: Docentes & Alumnos

# === Base de datos (PostgreSQL / MySQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_alumnos_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# === Servidor ===
REST_PORT=3003
GRPC_PORT=50053

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

NOTIFICACIONES_GRPC_HOST=ms-notificaciones
NOTIFICACIONES_GRPC_PORT=50056

PERIODOS_GRPC_HOST=ms-periodos
PERIODOS_GRPC_PORT=50052

# === CORS ===
CORS_ORIGIN=http://localhost:4200
