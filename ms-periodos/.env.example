# AGM - Academic Grade Management
# Variables de entorno para MS-2: Periodos & Materias

# === Base de datos (PostgreSQL / MySQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agm_periodos_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# === Servidor ===
REST_PORT=3002
GRPC_PORT=50052

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

# === CORS ===
CORS_ORIGIN=http://localhost:4200
