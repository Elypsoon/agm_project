# AGM - Academic Grade Management
# Variables de entorno para MS-2: Periodos & Materias

# === Base de datos (PostgreSQL) ===
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/agm_periodos_db

# === FastAPI ===
ENVIRONMENT=development
DEBUG=True

# === gRPC ===
GRPC_PORT=50052
GRPC_HOST=0.0.0.0

# === REST API ===
REST_PORT=3002
REST_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:4200", "http://localhost:3001"]

# === JWT ===
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256

# === Servidor ===
REST_PORT=3002
GRPC_PORT=50052

# === Conexiones gRPC a otros microservicios ===
AUTH_GRPC_HOST=ms-auth
AUTH_GRPC_PORT=50051

# === CORS ===
CORS_ORIGIN=http://localhost:4200
