# ============================================================================
# Django & MS-Periodos Configuration
# Copy this to .env and update values for your environment
# ============================================================================

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-to-a-secure-value
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,ms-periodos

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=agm_periodos_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# gRPC Server Configuration
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# REST API Configuration
REST_HOST=0.0.0.0
REST_PORT=3002

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200

# Environment Type
ENVIRONMENT=development

# JWT Configuration (if implementing JWT auth later)
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_ALGORITHM=HS256

# Additional CORS Origins (comma-separated)
CORS_ADDITIONAL_ORIGINS=

# Logging Level
LOG_LEVEL=INFO
